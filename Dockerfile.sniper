FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY api ./api
COPY worker ./worker
RUN ./node_modules/.bin/esbuild worker/sniper.ts --bundle --platform=node --format=esm --packages=external --outfile=sniper.mjs

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/sniper.mjs ./sniper.mjs
USER node
CMD ["node", "sniper.mjs"]
