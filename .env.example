# Set the same Solana Mainnet treasury for native SOL and wrapped SOL payments.
TREASURY_ADDRESS=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long, random secret used to derive recoverable prepaid API keys. Do not rotate without a recovery plan.
PAYWALL_SECRET=
PAYMENT_AMOUNT_SOL=0.1
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_FACILITATOR_TOKEN=
# Required for unsigned Jupiter swap plans.
JUPITER_API_KEY=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Operator-only sniper worker. Use a new job ID to re-arm after a plan is ready.
SNIPER_JOB_ID=
SNIPER_INPUT_MINT=
SNIPER_OUTPUT_MINT=
SNIPER_USER_PUBLIC_KEY=
SNIPER_INPUT_AMOUNT=
SNIPER_MIN_OUTPUT_AMOUNT=
SNIPER_SLIPPAGE_BPS=50
SNIPER_INTERVAL_MS=30000
# Set on Vercel for authenticated access to /api/sniper-status.
SNIPER_STATUS_SECRET=
# Set to the deployment origin, without a trailing slash.
APP_URL=http://localhost:3000
TELEMETRY_SECRET=
