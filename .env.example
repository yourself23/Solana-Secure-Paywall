# Treasury deposit address (configured per environment)
VITE_TREASURY_ADDRESS=
TREASURY_ADDRESS=

# Solana RPC endpoint
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Payment amount in SOL
VITE_PAYMENT_AMOUNT_SOL=0.1
PAYMENT_AMOUNT_SOL=0.1

# API calls granted per payment
VITE_API_CALLS_PER_PAYMENT=60
API_CALLS_PER_PAYMENT=60

# Payout interval in minutes
PAYOUT_INTERVAL_MINUTES=5

# Server-side secret for API authentication (generate with: openssl rand -hex 32)
API_AUTH_SECRET=

# Enable/disable honeypot bot trap
VITE_ENABLE_HONEYPOT=true
ENABLE_HONEYPOT=true