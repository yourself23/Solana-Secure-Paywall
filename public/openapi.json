{
  "openapi": "3.1.0",
  "info": {
    "title": "Solana Secure Paywall",
    "version": "2.0.0",
    "description": "Solana analytics and unsigned Jupiter swap plans. Prepaid passes use native SOL; x402 v2 exact payments use wrapped SOL."
  },
  "servers": [{ "url": "https://solana-secure-paywall.vercel.app" }],
  "components": {
    "securitySchemes": {
      "prepaidKey": { "type": "apiKey", "in": "header", "name": "x-api-key" }
    }
  },
  "paths": {
    "/api/sales": {
      "get": {
        "operationId": "getPaymentConfiguration",
        "summary": "Get the configured treasury, native SOL pass price and available engines",
        "responses": { "200": { "description": "Payment configuration" }, "503": { "description": "Payment configuration is unavailable" } }
      }
    },
    "/api/paywall": {
      "post": {
        "operationId": "redeemNativeSolPayment",
        "summary": "Redeem a native SOL transfer for a prepaid API key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["signature", "wallet", "walletProof"],
                "properties": {
                  "signature": { "type": "string", "description": "Confirmed transfer transaction signature" },
                  "wallet": { "type": "string", "description": "Transfer source and signer" },
                  "walletProof": { "type": "string", "description": "Base64 Ed25519 signature of paywall:<transaction signature>" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment redeemed; response includes apiKey and remaining credits" },
          "402": { "description": "Payment not confirmed or insufficient" },
          "403": { "description": "Invalid wallet proof" },
          "409": { "description": "Payment already redeemed" }
        }
      }
    },
    "/api/v1/invoke": {
      "post": {
        "operationId": "invokeEngine",
        "summary": "Invoke an available Solana analytics engine or create an unsigned swap plan",
        "description": "Use a prepaid x-api-key or the x402 v2 PAYMENT-REQUIRED and PAYMENT-SIGNATURE headers. Discover current engines and prices at /api/sales.",
        "security": [{}, { "prepaidKey": [] }],
        "parameters": [
          { "name": "libraryId", "in": "query", "required": false, "schema": { "type": "string", "default": "whale-wallet-tracker" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "targetWallet": { "type": "string" },
                  "mint": { "type": "string" },
                  "inputMint": { "type": "string" },
                  "outputMint": { "type": "string" },
                  "userPublicKey": { "type": "string" },
                  "amount": { "type": "string", "description": "Swap input amount in atomic units" },
                  "takingAmount": { "type": "string", "description": "Limit order output amount in atomic units" },
                  "slippageBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
                  "transactions": { "type": "array", "items": { "type": "string" }, "description": "Unsigned base64 transactions for a Jito bundle" },
                  "tipPayer": { "type": "string" },
                  "tipLamports": { "type": "integer", "minimum": 1000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Engine result; swap transactions are unsigned" },
          "402": { "description": "Payment required or prepaid credits exhausted" },
          "501": { "description": "Engine not implemented" },
          "503": { "description": "Upstream or payment service unavailable" }
        }
      }
    },
    "/api/solana/{tool}": {
      "get": {
        "operationId": "getSolanaTool",
        "summary": "Query Solana analytics using a wrapped SOL x402 payment",
        "parameters": [{ "name": "tool", "in": "path", "required": true, "schema": { "type": "string", "enum": ["whales", "rug-check", "fees", "pools", "boosts", "gpu-rates"] } }],
        "responses": { "200": { "description": "Tool result" }, "402": { "description": "Payment required" } }
      }
    },
    "/api/rpc/{method}": {
      "get": {
        "operationId": "getRpcData",
        "summary": "Query a Solana blockhash or token price using a wrapped SOL x402 payment",
        "parameters": [{ "name": "method", "in": "path", "required": true, "schema": { "type": "string", "enum": ["blockhash", "price"] } }],
        "responses": { "200": { "description": "RPC data" }, "402": { "description": "Payment required" } }
      },
      "post": {
        "operationId": "postSolanaRpc",
        "summary": "Call an allowlisted read-only Solana RPC method",
        "parameters": [{ "name": "method", "in": "path", "required": true, "schema": { "const": "solana" } }],
        "responses": { "200": { "description": "RPC response" }, "402": { "description": "Payment required" } }
      }
    }
  }
}
